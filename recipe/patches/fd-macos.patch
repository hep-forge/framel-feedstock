diff --git a/src/FdOs.h b/src/FdOs.h
new file mode 100644
index 0000000..e2b0897
--- /dev/null
+++ b/src/FdOs.h
@@ -0,0 +1,32 @@
+/* FdOs.h: what Fd's threads need from the OS (private, not installed) */
+#ifndef FdOs_h
+#define FdOs_h
+
+#include <pthread.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+#include <CfgQueue.h>
+#ifdef __APPLE__
+#include <stdint.h>
+#include <time.h>
+/* macOS: no gettid syscall, no pthread_getcpuclockid, no CPU affinity */
+static int FdGetTid(void) {
+  uint64_t tid = 0;
+  pthread_threadid_np(NULL, &tid);
+  return((int)tid);
+}
+/* only called by the thread whose CPU time it reads */
+#define FdThreadCpuClock(thrdId, clockId) (*(clockId) = CLOCK_THREAD_CPUTIME_ID)
+#define FdThreadCopyAffinity(thrdId)
+#else
+static int FdGetTid(void) { return((int)syscall(__NR_gettid)); }
+#define FdThreadCpuClock(thrdId, clockId) pthread_getcpuclockid((thrdId), (clockId))
+/*------------put the thread on the same CPU to avoid cache inefficiency---*/
+#define FdThreadCopyAffinity(thrdId) do {                              \
+    cpu_set_t cpuset;                                                  \
+    pthread_getaffinity_np(pthread_self(), sizeof(cpu_set_t), &cpuset);\
+    pthread_setaffinity_np((thrdId),       sizeof(cpu_set_t), &cpuset);\
+  } while(0)
+#endif
+
+#endif /* FdOs_h */
